<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>DA3 — DJ SVZ3</title>

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: Arial, Helvetica, sans-serif;
            background: #09090b;
            color: white;
        }

        /* NAVBAR */

        nav {
            height: 70px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0 7%;
            background: #101014;
            border-bottom: 1px solid #25252b;
        }

        .logo {
            font-size: 24px;
            font-weight: 900;
        }

        .logo span {
            color: #a855f7;
        }

        nav a {
            color: #aaa;
            text-decoration: none;
            margin-left: 25px;
            font-size: 14px;
        }

        nav a:hover {
            color: white;
        }

        /* HERO */

        .hero {
            text-align: center;
            padding: 110px 20px 100px;
            background:
                radial-gradient(
                    circle at center top,
                    #3b1760 0%,
                    transparent 55%
                );
        }

        .hero h1 {
            font-size: clamp(50px, 10vw, 90px);
            font-weight: 900;
            letter-spacing: -5px;
        }

        .hero h1 span {
            color: #a855f7;
        }

        .hero p {
            margin-top: 20px;
            color: #999;
            font-size: 18px;
        }

        .hero-button {
            display: inline-block;
            margin-top: 30px;
            padding: 13px 24px;
            background: #a855f7;
            color: white;
            text-decoration: none;
            border-radius: 8px;
            font-weight: bold;
        }

        /* CONTENT */

        main {
            max-width: 1000px;
            margin: auto;
            padding: 70px 20px;
        }

        .section-title {
            margin-bottom: 25px;
        }

        .section-title h2 {
            font-size: 28px;
        }

        .section-title p {
            color: #777;
            margin-top: 7px;
        }

        /* SONG CARD */

        .song {
            background: #141418;
            border: 1px solid #29292f;
            border-radius: 15px;
            padding: 25px;
            margin-bottom: 15px;
            transition: 0.2s;
        }

        .song:hover {
            border-color: #4b4b55;
        }

        .song-header {
            display: flex;
            align-items: center;
            gap: 18px;
            margin-bottom: 20px;
        }

        .cover {
            width: 65px;
            height: 65px;
            border-radius: 10px;
            background: linear-gradient(
                135deg,
                #a855f7,
                #27103d
            );
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 27px;
        }

        .song-info h3 {
            font-size: 19px;
        }

        .song-info p {
            color: #777;
            margin-top: 5px;
            font-size: 13px;
        }

        audio {
            width: 100%;
            height: 45px;
        }

        /* ABOUT */

        .about {
            margin-top: 80px;
            padding: 35px;
            background: #141418;
            border: 1px solid #29292f;
            border-radius: 15px;
        }

        .about h2 {
            margin-bottom: 12px;
        }

        .about p {
            color: #999;
            line-height: 1.7;
        }

        /* SOCIALS */

        .socials {
            margin-top: 25px;
            display: flex;
            gap: 10px;
            flex-wrap: wrap;
        }

        .socials a {
            padding: 10px 15px;
            background: #1c1c21;
            border: 1px solid #303037;
            border-radius: 7px;
            color: white;
            text-decoration: none;
            font-size: 14px;
        }

        .socials a:hover {
            border-color: #a855f7;
        }

        /* FOOTER */

        footer {
            border-top: 1px solid #25252b;
            padding: 30px 20px;
            text-align: center;
            color: #666;
            font-size: 13px;
        }

        @media (max-width: 600px) {

            nav {
                padding: 0 20px;
            }

            nav a {
                display: none;
            }

            .hero {
                padding-top: 80px;
            }

            .hero h1 {
                letter-spacing: -3px;
            }

            .song {
                padding: 18px;
            }
        }
    </style>
</head>

<body>

    <!-- NAVIGATION -->

    <nav>

        <div class="logo">
            Sample<span>Bin</span>
        </div>

        <div>
            <a href="#music">Music</a>
            <a href="#about">About</a>
            <a href="#socials">Socials</a>
        </div>

    </nav>


    <!-- HERO -->

    <section class="hero">

        <h1>
            DJ <span>SVZ3</span>
        </h1>

        <p>
            BNF • BREGA • RITMADA
        </p>

        <a href="#music" class="hero-button">
            Listen to my music
        </a>

    </section>


    <!-- MUSIC -->

    <main>

        <section id="music">

            <div class="section-title">

                <h2>My Music</h2>

                <p>
                    Listen to my latest tracks.
                </p>

            </div>


            <!-- SONG 1 -->

            <div class="song">

                <div class="song-header">

                    <div class="cover">
                        🎵
                    </div>

                    <div class="song-info">

                        <h3>
                            MTG POLAAR RITMADA
                        </h3>

                        <p>
                            DJ SVZ3 • Funk
                        </p>

                    </div>

                </div>

                <audio controls>

                    <source
                        src="MTG%20POLAAR%20RITMADA.wav"
                        type="audio/wav"
                    >

                    Your browser does not support audio.

                </audio>

            </div>


            <!-- ADD MORE SONGS HERE -->

            <div class="song">

                <div class="song-header">

                    <div class="cover">
                        🎵
                    </div>

                    <div class="song-info">

                        <h3>
                            Coming Soon
                        </h3>

                        <p>
                            DJ SVZ3
                        </p>

                    </div>

                </div>

                <p style="color:#666;">
                    More music coming soon...
                </p>

            </div>

        </section>


        <!-- ABOUT -->

        <section id="about" class="about">

            <h2>
                About
            </h2>

            <p>
                Welcome to DA3. I'm DJ SVZ3, a producer
                making ritmada, brega, bnf and more!
            </p>

        </section>


        <!-- SOCIALS -->

        <section id="socials" class="about">

            <h2>
                Find Me
            </h2>

            <div class="socials">

                <a href="#" target="_blank">
                    YouTube
                </a>

                <a href="#" target="_blank">
                    Discord
                </a>

                <a href="#" target="_blank">
                    SoundCloud
                </a>

            </div>

        </section>

    </main>


    <!-- FOOTER -->

    <footer>

        © 2026 DA3 • DJ SVZ3

    </footer>

</body>
</html>
